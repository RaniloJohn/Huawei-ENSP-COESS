<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<lab name="Lab-30-Huawei-Dual-Core-Campus-Redundant-Static" id="4a0b4610-67da-475a-a0c9-976bcf08a4ea" version="1" scripttimeout="300" lock="0" description="Huawei Campus Backbone: Dual-Core Static Routing with Bidirectional Path Redundancy.">
  <topology>
    <nodes>
      <node id="1" name="R1" type="qemu" template="huaweiar1k" image="huaweiar1k-5.170" console="telnet" cpu="2" cpulimit="0" ram="4096" ethernet="6" uuid="02a6ead4-3374-4511-8485-8b0b2c5cace7" qemu_options="-machine type=pc,accel=kvm -vga std -usbdevice tablet -boot order=cd -cpu host" qemu_version="2.12.0" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Router.png" config="0" left="620" top="140">
        <interface id="0" name="GE0/0/0" type="ethernet" network_id="1"/>
        <interface id="1" name="GE0/0/1" type="ethernet" network_id="2"/>
      </node>
      <node id="2" name="R2" type="qemu" template="huaweiar1k" image="huaweiar1k-5.170" console="telnet" cpu="2" cpulimit="0" ram="4096" ethernet="6" uuid="cdf5bf4f-dbc8-45cc-aab0-2ca3eeeb7252" qemu_options="-machine type=pc,accel=kvm -vga std -usbdevice tablet -boot order=cd -cpu host" qemu_version="2.12.0" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Router.png" config="0" left="920" top="140">
        <interface id="0" name="GE0/0/0" type="ethernet" network_id="1"/>
        <interface id="1" name="GE0/0/1" type="ethernet" network_id="3"/>
      </node>
      <node id="3" name="PC1" type="vpcs" template="vpcs" ethernet="1" console="" delay="0" icon="Desktop.png" config="0" left="620" top="320">
        <interface id="0" name="eth0" type="ethernet" network_id="2"/>
      </node>
      <node id="4" name="PC2" type="vpcs" template="vpcs" ethernet="1" console="" delay="0" icon="Desktop.png" config="0" left="920" top="320">
        <interface id="0" name="eth0" type="ethernet" network_id="3"/>
      </node>
    </nodes>
    <networks>
      <network id="1" type="bridge" name="Link-R1-R2" left="800" top="300" visibility="0" icon="lan.png"/>
      <network id="2" type="bridge" name="Link-R1-PC1" left="800" top="300" visibility="0" icon="lan.png"/>
      <network id="3" type="bridge" name="Link-R2-PC2" left="800" top="300" visibility="0" icon="lan.png"/>
    </networks>
  </topology>
  <objects>
    <textobjects>
      <textobject id="1" name="Lab_Card" type="text">
        <data></data>
      </textobject>
    </textobjects>
  </objects>
  <configs>
    <config id="1" name="R1">system-view
sysname R1
aaa
 local-user admin password cipher admin
 local-user admin service-type telnet ssh terminal
 local-user admin privilege level 15
 local-user super password cipher super
 local-user super service-type telnet ssh terminal
 local-user super privilege level 15
 quit
super password cipher super
user-interface vty 0 4
 authentication-mode aaa
 user privilege level 15
 quit
interface GigabitEthernet 0/0/0
 ip address 10.1.12.1 255.255.255.0
 quit
interface GigabitEthernet 0/0/1
 ip address 192.168.10.1 255.255.255.0
 quit
ip route-static 192.168.20.0 255.255.255.0 10.1.12.2</config>
    <config id="2" name="R2">system-view
sysname R2
aaa
 local-user admin password cipher admin
 local-user admin service-type telnet ssh terminal
 local-user admin privilege level 15
 local-user super password cipher super
 local-user super service-type telnet ssh terminal
 local-user super privilege level 15
 quit
super password cipher super
user-interface vty 0 4
 authentication-mode aaa
 user privilege level 15
 quit
interface GigabitEthernet 0/0/0
 ip address 10.1.12.2 255.255.255.0
 quit
interface GigabitEthernet 0/0/1
 ip address 192.168.20.1 255.255.255.0
 quit
ip route-static 192.168.10.0 255.255.255.0 10.1.12.1</config>
  </configs>
