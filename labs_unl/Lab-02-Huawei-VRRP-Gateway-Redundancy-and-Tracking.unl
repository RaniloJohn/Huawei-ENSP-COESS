  <configs>
    <config id="1" name="Core-R3">system-view
sysname Core-R3
aaa
 local-user admin password cipher admin
 local-user admin service-type telnet ssh terminal
 local-user admin privilege level 15
 local-user super password cipher super
 local-user super service-type telnet ssh terminal
 local-user super privilege level 15
 quit
super password cipher super
user-interface vty 0 4
 authentication-mode aaa
 user privilege level 15
 quit
interface GigabitEthernet 0/0/0
 ip address 10.1.13.3 255.255.255.0
 quit
interface GigabitEthernet 0/0/1
 ip address 10.1.23.3 255.255.255.0
 quit
ip route-static 192.168.1.0 255.255.255.0 10.1.13.1 preference 60
ip route-static 192.168.1.0 255.255.255.0 10.1.23.2 preference 100</config>
    <config id="2" name="Master-GW1">system-view
sysname Master-GW1
aaa
 local-user admin password cipher admin
 local-user admin service-type telnet ssh terminal
 local-user admin privilege level 15
 local-user super password cipher super
 local-user super service-type telnet ssh terminal
 local-user super privilege level 15
 quit
super password cipher super
user-interface vty 0 4
 authentication-mode aaa
 user privilege level 15
 quit
interface GigabitEthernet 0/0/0
 ip address 10.1.13.1 255.255.255.0
 quit
interface GigabitEthernet 0/0/1
 ip address 192.168.1.1 255.255.255.0
 vrrp vrid 1 virtual-ip 192.168.1.254
 vrrp vrid 1 priority 120
 vrrp vrid 1 preempt-mode timer delay 20
 vrrp vrid 1 track interface GigabitEthernet0/0/0 reduced 30
 quit
ip route-static 0.0.0.0 0.0.0.0 10.1.13.3</config>
    <config id="3" name="Backup-GW2">system-view
sysname Backup-GW2
aaa
 local-user admin password cipher admin
 local-user admin service-type telnet ssh terminal
 local-user admin privilege level 15
 local-user super password cipher super
 local-user super service-type telnet ssh terminal
 local-user super privilege level 15
 quit
super password cipher super
user-interface vty 0 4
 authentication-mode aaa
 user privilege level 15
 quit
interface GigabitEthernet 0/0/0
 ip address 10.1.23.2 255.255.255.0
 quit
interface GigabitEthernet 0/0/1
 ip address 192.168.1.2 255.255.255.0
 vrrp vrid 1 virtual-ip 192.168.1.254
 quit
ip route-static 0.0.0.0 0.0.0.0 10.1.23.3</config>
  </configs>
</lab>