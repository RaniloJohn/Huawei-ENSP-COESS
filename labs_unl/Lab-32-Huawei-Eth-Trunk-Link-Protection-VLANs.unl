<lab name="Lab-32-Huawei-Eth-Trunk-Link-Protection-VLANs" id="b6838c25-4932-4e43-8108-dd5130b2090e" version="1" scripttimeout="300" lock="0" description="Huawei L2 Hardening: Eth-Trunk Active/Standby Thresholds and Security VLAN Pruning.">
  <topology>
    <nodes>
      <node id="1" name="Core-SW1" type="qemu" template="huaweiar1k" image="huaweiar1k-5.170" console="telnet" cpu="2" cpulimit="0" ram="4096" ethernet="6" uuid="5b4c18db-1a6f-4a2d-9a9b-59a445f68ede" qemu_options="-machine type=pc,accel=kvm -vga std -usbdevice tablet -boot order=cd -cpu host" qemu_version="2.12.0" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Switch L32.png" config="0" left="620" top="140">
        <interface id="0" name="GE0/0/0" type="ethernet" network_id="1"/>
        <interface id="1" name="GE0/0/1" type="ethernet" network_id="2"/>
      </node>
      <node id="2" name="Dist-SW2" type="qemu" template="huaweiar1k" image="huaweiar1k-5.170" console="telnet" cpu="2" cpulimit="0" ram="4096" ethernet="6" uuid="0310a626-eeed-45d7-a8fe-8bc946dc492b" qemu_options="-machine type=pc,accel=kvm -vga std -usbdevice tablet -boot order=cd -cpu host" qemu_version="2.12.0" qemu_arch="x86_64" qemu_nic="virtio-net-pci" delay="0" icon="Switch L32.png" config="0" left="920" top="140">
        <interface id="0" name="GE0/0/0" type="ethernet" network_id="1"/>
        <interface id="1" name="GE0/0/1" type="ethernet" network_id="3"/>
