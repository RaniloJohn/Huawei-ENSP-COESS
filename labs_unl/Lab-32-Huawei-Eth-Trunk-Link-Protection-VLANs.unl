        <interface id="0" name="eth0" type="ethernet" network_id="2"/>
      </node>
      <node id="4" name="PC2" type="vpcs" template="vpcs" ethernet="1" console="" delay="0" icon="Desktop.png" config="0" left="920" top="320">
        <interface id="0" name="eth0" type="ethernet" network_id="3"/>
      </node>
    </nodes>
    <networks>
