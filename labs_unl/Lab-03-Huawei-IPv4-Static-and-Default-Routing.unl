  </objects>
  <configs>
    <config id="1" name="Branch-R1">system-view
sysname Branch-R1
aaa
 local-user admin password cipher admin
 local-user admin service-type telnet ssh terminal
 local-user admin privilege level 15
 local-user super password cipher super
 local-user super service-type telnet ssh terminal
 local-user super privilege level 15
 quit
super password cipher super
user-interface vty 0 4
 authentication-mode aaa
 user privilege level 15
 quit
interface GigabitEthernet 0/0/0
 ip address 10.1.12.1 255.255.255.0
 quit
interface GigabitEthernet 0/0/1
 ip address 192.168.10.1 255.255.255.0
 quit
ip route-static 0.0.0.0 0.0.0.0 10.1.12.2</config>
    <config id="2" name="HQ-R2">system-view
sysname HQ-R2
aaa
 local-user admin password cipher admin
 local-user admin service-type telnet ssh terminal
 local-user admin privilege level 15
 local-user super password cipher super
 local-user super service-type telnet ssh terminal
 local-user super privilege level 15
 quit
super password cipher super
user-interface vty 0 4
 authentication-mode aaa
 user privilege level 15
 quit
interface GigabitEthernet 0/0/0
 ip address 10.1.12.2 255.255.255.0
 quit
interface GigabitEthernet 0/0/1
 ip address 10.1.23.2 255.255.255.0
 quit
ip route-static 192.168.10.0 255.255.255.0 10.1.12.1
ip route-static 192.168.30.0 255.255.255.0 10.1.23.3</config>
    <config id="3" name="Cloud-R3">system-view
sysname Cloud-R3
aaa
 local-user admin password cipher admin
 local-user admin service-type telnet ssh terminal
 local-user admin privilege level 15
 local-user super password cipher super
 local-user super service-type telnet ssh terminal
 local-user super privilege level 15
 quit
super password cipher super
user-interface vty 0 4
 authentication-mode aaa
 user privilege level 15
 quit
interface GigabitEthernet 0/0/0
